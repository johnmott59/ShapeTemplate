using System.Threading.Tasks;
using System.Xml.Linq;
using ShapeTemplateLib.BasicShapes;
using System.Web.Script.Serialization;

namespace ShapeTemplateLib.Templates.User0 
{
    public partial class <#=Classname#> <#=sc#>
    {

<#+
}
//==========================================================================
void GenerateFooter() {
#>

	}
}
<#+

}

#>