<#@ template debug="true" hostspecific="true" language="C#" #> 
<#@ output extension=".txt" #> 
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ include file="EF.Utility.CS.ttinclude"#> 
 
<#
	var fileManager = EntityFrameworkTemplateFileManager.Create(this);

	string Classname = "TestTemplateClass";
	// If this is a template it will generate a template element. If not its a normal class and will generate a class element
	bool IsTemplate = false;

	// This template will automatically generate the ILoadAndSaveProperties methods
	// if this inherits compilable root then the get and load properties are overrides and need to be marked as such
	// If this only implements ILoadAndSaveProperties it doesn't need to be declared as a template
	bool InheritsCompilableRoot = false;

	List<TemplateProperty> list = new List<TemplateProperty>() {
	
		new TemplateProperty () { PropertyName = "LSListList"	
			,PropertyType="LineSegmentList"		
			,PropertyCategory = "List"		// Object, Simple or List
			,XMLPosition="TemplateProperty"
			,ControlName="TextBox"
			},	
		new TemplateProperty () { PropertyName = "ID"	
			,PropertyType="string"		
			,PropertyCategory = "Simple"		// Object, Simple or List
			,XMLPosition="TemplateProperty"
			,ControlName="TextBox"
			},								

	};

	fileManager.StartHeader(); 

	fileManager.StartNewFile("Compile.cs");
	Compile(Classname);

	fileManager.StartNewFile(Classname + ".cs"); 
	ClassProperties(Classname,list);

	fileManager.StartNewFile("EditorTabList.cs");
	EditorTabList(Classname,list);

	fileManager.StartNewFile("GetProperties.cs"); 
	GetProperties(Classname,list,IsTemplate,InheritsCompilableRoot);

	fileManager.StartNewFile("LoadProperties.cs"); 
	LoadProperties(Classname,list,InheritsCompilableRoot);

	fileManager.StartNewFile("GetJSON.cs"); 
	GetJSON(Classname,list);

	fileManager.StartNewFile("LoadJSON.cs"); 
	LoadJSON(Classname,list);
	
	fileManager.Process(); 

#>
<#+
/*
 * This class contains the information we need to generate each property of the class.
 * Its defined here because of the way templates work, this will be generated as part of the class generated by the template
 */
public class TemplateProperty {
	public string PropertyName	{get;set;}
	public string PropertyType	{get;set;}
	public string PropertyCategory {get;set;}	// Object, Simple or List
	public string XMLPosition	{get;set;}
	
	public string ControlName	{get;set;}
	

}

//==========================================================================
void Compile(string Classname) {

GenerateHeader(Classname);

	#>
		public override XElement Compile () {
			// Return a combination of templates and/or basic shapes
			return new XElement("root");
		}  

	<#+

GenerateFooter();

}

//==========================================================================
void ClassProperties(string Classname,List<TemplateProperty> TemplatePropertyList) {
GenerateHeader(Classname,true);

#>	
		// Constructor, initialize any object or array properties
		public <#=Classname#>() {
		<#+
		foreach(TemplateProperty o in TemplatePropertyList) {
			switch (o.PropertyCategory) {
				case "Object":
				#>
					<#=o.PropertyName#> = new <#=o.PropertyType#>();
				<#+
				break;
				case "List":
				#>
					<#=o.PropertyName#> = new <#=o.PropertyType#>[0];
				<#+
				break;
				case "Simple":
				break;
			}
		}
		#>

	}
	
<#+


foreach(TemplateProperty o in TemplatePropertyList) {
	#>

        /// <summary>
        ///  <#=o.PropertyName#>  
        /// </summary>
	    [HelpProperty(SampleValue = "", XPropertyPosition = HelpPropertyAttribute.eXPropertyPosition.<#=o.XMLPosition#>)]
     <#+
	 if (o.PropertyCategory == "List") {
	 #>
		public <#=o.PropertyType#>[] <#=o.PropertyName#> { get; set; } 
	 <#+	 
	 } else {
	 #>
		public <#=o.PropertyType#> <#=o.PropertyName#> { get; set; } 
	 <#+	 
	 }

}
GenerateFooter();
}
//==========================================================================
void EditorTabList(string Classname,List<TemplateProperty> TemplatePropertyList) {
GenerateHeader(Classname);
#>
        /// <summary>
        /// This contains the editor definitions needed to modify this template in the browser. This property is 
        /// only necessary if the template is to be edited in the browser, if its accessed from the API its not used.
        /// </summary>
        public override List<EditorTab> EditorTabList { get; set; } = new List<EditorTab>()
        {
                new EditorTab()
                {
                     EditorRowList=new List<EditorRow>()
                     {

<#+

foreach(TemplateProperty o in TemplatePropertyList) {
	#>

                    new EditorRow() {
                              EditorColumnList=new List<EditorColumn>()
                              {
                                   new EditorColumn()
                                   {
                                        ColumnType=EditorColumn.eColumnType.Label,
                                        Label="<#=o.PropertyName#>",
                                        Width=2

                                   },
                                   new EditorColumn()
                                   {
                                        ColumnType=EditorColumn.eColumnType.Control,
                                        PropertyName="<#=o.PropertyName#>",
                                        ControlName="TextBox",
                                        Width=4
                                   }

                              }
                         },
	<#+
}

#>
					}
				}	
		};
<#+


GenerateFooter();
}
//==========================================================================
void GetProperties(string Classname,List<TemplateProperty> TemplatePropertyList,bool IsTemplate, bool InheritsCompilableRoot) {

GenerateHeader(Classname);

string sover = InheritsCompilableRoot ? "override" : "";

#>
	public <#=sover#> XElement GetProperties(string PropertyName = "")
    {
		<#+
		if (IsTemplate) {
		#>
          XElement root = new XElement("template",
                new XAttribute("prop", PropertyName),
                new XAttribute("user", "User0"),
                new XAttribute("name", "<#=Classname#>".ToLower()));
		<#+
		} else {
		#>
          XElement root = new XElement("<#=Classname.ToLower()#>",new XAttribute("prop", PropertyName));
		<#+
		}
		#>

<#+
foreach(TemplateProperty o in TemplatePropertyList) {

		switch (o.PropertyCategory) {
			case "Object":
			#>

				root.Add(<#=o.PropertyName#>.GetProperties("<#=o.PropertyName.ToLower()#>"));
			<#+
			break;
			case "List":
			#>

				XElement X<#=o.PropertyName#> = new XElement("list", new XAttribute("name", nameof(<#=o.PropertyName#>).ToLower()));
				root.Add(X<#=o.PropertyName#>);
				X<#=o.PropertyName#>.Add(Get<#=o.PropertyName#>().Elements());
			<#+	
			break;
			case "Simple":
			#> 
				root.Add(new XElement("property", new XAttribute(nameof(<#=o.PropertyName#>).ToLower(), <#=o.PropertyName#>)));
			<#+
			break;
			}

}
#>
                
            return root;
	}
<#+
/*
 * Generate 'get'  routines for each property that is an array 
 */
 foreach(TemplateProperty o in TemplatePropertyList.Where(m=>m.PropertyCategory == "List")) {
	GenerateGetList(o.PropertyName,o.PropertyType,o.PropertyName);
 }

GenerateFooter();

}
// =============================================================================
void GenerateGetList(string PropertyName,string ElementType,string ListMember)	
{
#>

      //--------------------------------
        protected XElement Get<#= PropertyName #>()
        {
            // Add the vertices and the edges
            XElement XList = new XElement("<#= PropertyName.ToLower()#>");

            foreach (<#= ElementType #> r in <#= PropertyName #>)
            {
                XList.Add(r.GetProperties());              
            }

            return XList;
        }

<#+
}
// ==============================================================================
void GenerateLoadList(string ListElementName,string ElementType,string ListMember)	
{
#>
	public bool Load<#=ListElementName#>(XElement Xele, out string message)
        {
            message = "OK";

            XElement XList = Utilities.GetListElement(Xele, "<#=ListElementName.ToLower()#>");

            // ok if there are no items
            if (XList == null) return true;

            List<<#=ElementType#>> list = new List<<#=ElementType#>>();
            foreach (XElement x in XList.Elements("<#=ElementType.ToLower()#>"))
            {
                <#=ElementType#> o = new <#=ElementType#>();
                if (!o.LoadProperties(x, out message)) return false;
                list.Add(o);
            }

            <#=ListElementName#> = list.ToArray();
            
            return true;
        }

<#+
}
//==========================================================================
void LoadProperties(string Classname,List<TemplateProperty> TemplatePropertyList,bool InheritsCompilableRoot) {

GenerateHeader(Classname);

string sover = InheritsCompilableRoot ? "override" : "";

#>
       public <#=sover#> bool LoadProperties(XElement xTemplateNode, out string message)
       {
			float fTmp;
			int iTmp;
			string sTmp;

			message = "OK";
			XElement xNode;
       <#+

	   foreach(TemplateProperty o in TemplatePropertyList) {

			switch (o.PropertyCategory) {
				case "Object":
				#>
					xNode = Utilities.GetNamedElementWithPropAttribute(xTemplateNode, "<#=o.PropertyType.ToLower()#>", "<#=o.PropertyName.ToLower()#>",out message);
					if (xNode == null) return false;
					if (!<#=o.PropertyName#>.LoadProperties(xNode, out message)) return false;					
				<#+
				break;

				case "List":
				#>
					if (!Load<#=o.PropertyName#>(xTemplateNode, out message)) return false;
				<#+
				break;

				case "Simple":
					switch (o.PropertyType) {
					case "string":
					#>

						if (!Utilities.GetStringProperty(xTemplateNode, nameof(<#=o.PropertyName#>), out sTmp, out message)) return false;
						<#=o.PropertyName#> = sTmp;
					<#+
					break;
					case "float":
					#>

						if (!Utilities.GetFloatProperty(xTemplateNode, nameof(<#=o.PropertyName#>), out fTmp, out message)) return false;
						<#=o.PropertyName#> = fTmp;
					<#+
						break;
					case "int":
					#>

						if (!Utilities.GetIntProperty(xTemplateNode, nameof(<#=o.PropertyName#>), out iTmp, out message)) return false;
						<#=o.PropertyName#> = iTmp;
					<#+
						break;
					}
				break;
			}
		}
	   #>

	   return true;
	   }
<#+

/*
 * Generate 'load'  routines for each property that is an array 
 */
 foreach(TemplateProperty o in TemplatePropertyList.Where(m=>m.PropertyCategory == "List")) {
	GenerateLoadList(o.PropertyName,o.PropertyType,o.PropertyName);
 }


GenerateFooter();

}
//==========================================================================
void GetJSON(string Classname,List<TemplateProperty> TemplatePropertyList) {

GenerateHeader(Classname);
#>
        public override JSONDataTrain GetJSONDataTrain()
        {
            JavaScriptSerializer ser = new JavaScriptSerializer();

            List<JSONDataCarriage> list = new List<JSONDataCarriage>()
            {

<#+
foreach(TemplateProperty o in TemplatePropertyList) {
	#> 
			new JSONDataCarriage() {
				fieldname = "<#=o.PropertyName#>",
                fieldvalue = ser.Serialize(<#=o.PropertyName#> )
			},
	<#+
}
#>

			};

			return new JSONDataTrain() { JSONDataCarriageArray = list.ToArray() };
		}

<#+
GenerateFooter();

}

//==========================================================================
void LoadJSON(string Classname,List<TemplateProperty> TemplatePropertyList) {

GenerateHeader(Classname);

#>

     public override void LoadJSONDataTrain(string sDataTrain)
     {
		JavaScriptSerializer ser = new JavaScriptSerializer();
        /*
         * Decode this data train
         */
        JSONDataTrain oDataTrain = ser.Deserialize<JSONDataTrain>(sDataTrain);
        /*
         * Load each of the values from their carriage
         */
        JSONDataCarriage oCarriage;

<#+
foreach(TemplateProperty o in TemplatePropertyList) {
	#> 
	        oCarriage = oDataTrain.JSONDataCarriageArray.Where(m => m.fieldname == nameof(<#=o.PropertyName#>)).FirstOrDefault();
            if (oCarriage != null)
            {
                <#=o.PropertyName#> = ser.Deserialize<<#=o.PropertyType#>>(oCarriage.fieldvalue);
            }
	<#+
}
#>

		
	}
<#+
GenerateFooter();

}

//==========================================================================
void GenerateHeader(string Classname, bool Subclass = false) {

string sc = Subclass ? ": TemplateBaseClass" : "";
#>

using System;
using System.Collections.Generic;
